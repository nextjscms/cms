{
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireBranch": "master",
    "requireCleanWorkingDir": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "after:bump": "npm version ${version} --workspace=packages/core --no-git-tag-version",
    "after:release": "gh release create v${version} --generate-notes"
  }
}