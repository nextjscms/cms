{
  "name": "Visitor Analytics",
  "version": "1.0.0",
  "description": "A privacy-friendly analytics plugin.",
  "author": "NextjsCMS Core",
  "category": "Analytics",
  "imageUrl": "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2000&auto=format&fit=crop",
  "adminMenu": {
    "label": "Analytics",
    "icon": "LineChart"
  },
  "settingsSchema": [
    {
      "key": "trackingId",
      "label": "Tracking ID",
      "type": "string",
      "required": true
    },
    {
      "key": "enableAdvanced",
      "label": "Enable Advanced Tracking",
      "type": "boolean"
    },
    {
      "key": "advancedOptions",
      "label": "Advanced Configuration",
      "type": "object",
      "showIf": { "field": "enableAdvanced", "equals": true },
      "children": [
        { "key": "trackEvents", "label": "Track Custom Events", "type": "boolean" },
        { "key": "retentionDays", "label": "Data Retention (Days)", "type": "number" }
      ]
    },
    {
      "key": "ignoredIps",
      "label": "Ignored IP Addresses",
      "type": "array",
      "children": [
        { "key": "ip", "label": "IP Address", "type": "string" },
        { "key": "reason", "label": "Reason", "type": "string" }
      ]
    }
  ]
}
