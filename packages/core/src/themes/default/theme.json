{
  "name": "Default Theme",
  "slug": "default",
  "version": "1.0.0",
  "author": "NextjsCMS",
  "description": "The default clean, modern theme for NextjsCMS.",
  "settingsSchema": [
    {
      "id": "siteName",
      "label": "Site Name",
      "type": "text",
